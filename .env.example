# ---- Brain (Claude API) ----
# Get a key at https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Any current Claude model ID from the console's Models page (Sonnet = best quality/cost balance)
CLAUDE_MODEL=claude-sonnet-4-5
MAX_TOKENS=400

# ---- Voice (ElevenLabs) ----
# https://elevenlabs.io  ->  Developers / API Keys
ELEVENLABS_API_KEY=
# Voices -> My Voices -> (NKC voice) -> ... -> Copy voice ID
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 = best quality (Hindi + English); eleven_flash_v2_5 = lowest latency
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.15
# Speaking speed: 0.7 (slowest) .. 1.0 (normal) .. 1.2. The Pace menu in the app overrides this.
ELEVENLABS_SPEED=0.88
# Seconds to wait for ElevenLabs before falling back to the machine voice
ELEVENLABS_TIMEOUT=8

# ---- Hosting (Vercel) ----
# Passcode people must enter before using the app. Leave empty on your own computer.
APP_PASSCODE=
# Conversation history storage when hosted (Vercel's Upstash integration fills these in for you).
# Without them, history is kept as files in ./conversations (works only on your own computer).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Max parallel ElevenLabs requests per server copy (your plan's limit is shared by all copies)
ELEVENLABS_MAX_CONCURRENT=2
